{
    "rootDir": "src",
    "files": [
        "**/*"
    ],
    "stagingDir": "dist",
    "retainStagingDir": true,
    "createPackage": false,
    "watch": false,
    //this flag tells BrighterScript that for every xml file, try to import a .bs file with the same name and location
    "autoImportComponentScript": true,
    "sourceMap": true
}
